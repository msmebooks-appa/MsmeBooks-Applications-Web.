rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 255 &&
             data.fullName is string && data.fullName.size() <= 128 &&
             data.role in ['candidate', 'employer', 'agency', 'headhunter', 'partner'];
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{testId} {
      allow read: if true;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().email == existing().email;
      allow delete: if isOwner(userId);

      // Subcollection: Applications
      match /applications/{applicationId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().userId == userId && isValidId(applicationId);
        allow update: if isOwner(userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      // Subcollection: Job Alerts
      match /jobAlerts/{alertId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().userId == userId && isValidId(alertId);
        allow update: if isOwner(userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      // Subcollection: Saved Jobs
      match /savedJobs/{jobId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().userId == userId && isValidId(jobId);
        allow update: if isOwner(userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
